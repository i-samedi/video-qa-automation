Feature: Proceso de carga de pedidos a bodegas # app/features/scenario.feature:1

  Background:   # app/features/scenario.feature:3

  @paso_1 @modulo_carga_pedidos @tipo_seleccion
  Scenario: 1 Selección de bodega origen                     # app/features/scenario.feature:10
    Given el usuario está en la pantalla de carga de pedidos # app/features/steps/scenario_steps_playwright.py:16
    And tiene acceso a todas las opciones necesarias         # app/features/steps/scenario_steps_playwright.py:21
    And los parámetros iniciales están configurados          # app/features/steps/scenario_steps_playwright.py:25
    When el usuario selecciona la bodega origen del despacho # app/features/steps/scenario_steps_playwright.py:29
    Then la bodega 2 es seleccionada correctamente           # app/features/steps/scenario_steps_playwright.py:61

  @paso_2 @modulo_carga_pedidos @tipo_ingreso
  Scenario: 2 Ingreso de RUT                                 # app/features/scenario.feature:15
    Given el usuario está en la pantalla de carga de pedidos # app/features/steps/scenario_steps_playwright.py:16
    And tiene acceso a todas las opciones necesarias         # app/features/steps/scenario_steps_playwright.py:21
    And los parámetros iniciales están configurados          # app/features/steps/scenario_steps_playwright.py:25
    When el usuario ingresa el RUT correspondiente al pedido # app/features/steps/scenario_steps_playwright.py:66
    Then el RUT 123456789 es ingresado correctamente         # app/features/steps/scenario_steps_playwright.py:73

  @paso_3 @modulo_carga_pedidos @tipo_seleccion
  Scenario: 3 Selección de destino                           # app/features/scenario.feature:20
    Given el usuario está en la pantalla de carga de pedidos # app/features/steps/scenario_steps_playwright.py:16
    And tiene acceso a todas las opciones necesarias         # app/features/steps/scenario_steps_playwright.py:21
    And los parámetros iniciales están configurados          # app/features/steps/scenario_steps_playwright.py:25
    When el usuario selecciona el destino en el dropdown     # app/features/steps/scenario_steps_playwright.py:77
    Then la ubicación número 1 es seleccionada correctamente # app/features/steps/scenario_steps_playwright.py:109

  @paso_4 @modulo_carga_pedidos @tipo_ingreso
  Scenario: 4 Ingreso de número de pedido                                   # app/features/scenario.feature:25
    Given el usuario está en la pantalla de carga de pedidos                # app/features/steps/scenario_steps_playwright.py:16
    And tiene acceso a todas las opciones necesarias                        # app/features/steps/scenario_steps_playwright.py:21
    And los parámetros iniciales están configurados                         # app/features/steps/scenario_steps_playwright.py:25
    When el usuario ingresa el número de pedido en el campo correspondiente # app/features/steps/scenario_steps_playwright.py:113
    Then el número de pedido 987 es ingresado correctamente                 # app/features/steps/scenario_steps_playwright.py:132

  @paso_5 @modulo_carga_pedidos @tipo_confirmacion
  Scenario: 5 Confirmación de grabación de pedido            # app/features/scenario.feature:30
    Given el usuario está en la pantalla de carga de pedidos # app/features/steps/scenario_steps_playwright.py:16
    And tiene acceso a todas las opciones necesarias         # app/features/steps/scenario_steps_playwright.py:21
    And los parámetros iniciales están configurados          # app/features/steps/scenario_steps_playwright.py:25
    When el usuario hace clic en el botón grabar pedidos     # app/features/steps/scenario_steps_playwright.py:139
    Then el pedido es grabado y el proceso queda completado  # app/features/steps/scenario_steps_playwright.py:165

