{
    "page": {
        "title": "h1:text(\"Carga de Pedidos a Bodegas\")"
    },
    "panel1": {
        "container": "#panel1",
        "inputs": {
            "observaciones": "#editobs",
            "lineasRechazadas": "#editlinerechazo",
            "cantidadRechazada": "#editcantrechazo"
        },
        "buttons": {
            "grabarPedidos": "#botongenerar",
            "cancelar": "#botoncancelar",
            "exportarDatos": "#botonexportar",
            "exportarOTR": "#botonexporotr",
            "salir": "#botonsalir"
        }
    },
    "panel2": {
        "container": "#panel2",
        "buttons": {
            "button1": "#button1",
            "button2": "#button2"
        }
    },
    "panel5": {
        "container": "#panel5",
        "tabs": {
            "pedido": "button[value=\"pedido\"]",
            "stock": "button[value=\"stock\"]",
            "otr": "button[value=\"otr\"]"
        },
        "textareas": {
            "mensajeEmail": "#mensajeemail"
        }
    },
    "groupBox1": {
        "container": "#groupbox1",
        "title": "h3:text(\"Origen Despacho\")",
        "selects": {
            "bodega": "#combobodega"
        },
        "checkboxes": {
            "homologarCliente": "#checkboxhomologaclte",
            "soloStock": "#checkboxstock"
        },
        "buttons": {
            "asignarStock": "#botonstock"
        }
    },
    "groupBox2": {
        "container": "#groupbox2",
        "title": "h3:text(\"CSV Separado Por\")",
        "radioButtons": {
            "puntoComa": "#rbpuntocoma",
            "coma": "#rbcoma"
        }
    },
    "groupBox3": {
        "container": "#groupbox3",
        "inputs": {
            "rut": "#editrut",
            "cliente": "#editcliente",
            "ordenCompra": "#editoc",
            "porcentajeDescuento": "#editpordcto",
            "numeroPedido": "#editnropedido",
            "fechaEntregaInicial": "#fechaentinicial",
            "fechaEntregaFinal": "#fechaentfinal",
            "fechaExpiracion": "#fechaexpiracion"
        },
        "selects": {
            "ubicacion": "#comboubicacion",
            "condicionVenta": "#combocondicionventa"
        },
        "buttons": {
            "archivo": "#botonarchivo"
        }
    },
    "groupBox4": {
        "container": "#groupbox4",
        "title": "h3:text(\"Tipo Pedido\")",
        "radioButtons": {
            "normal": "#rbnormal",
            "apertura": "#rbapertura",
            "llenado": "#rbllenado",
            "cross": "#rbcross",
            "noCol": "#rbnocol",
            "acc": "#rbacc",
            "rt": "#rbrt",
            "foto": "#rbfoto",
            "vtaec": "#rbvtaec",
            "campana": "#rbcampana",
            "reserva": "#rbreserva",
            "stockReservado": "#rbstockreservado",
            "traspasoWhs": "#rbtraspasowhs",
            "desarme": "#rbdesarme",
            "regula": "#rbregula",
            "consigna": "#rbconsigna",
            "repoAs": "#rbrepoas",
            "llenadoAs": "#rbllenadoas",
            "carrito": "#rbcarrito"
        }
    },
    "grillas": {
        "detalle": {
            "container": "#grilladetalle",
            "headers": [
                "C/Tienda",
                "Tienda",
                "C/Modelo",
                "C/Color",
                "Modelo",
                "Color",
                "Nº",
                "SKU",
                "Pedido",
                "P/Venta",
                "Saldo Stock",
                "Genera",
                "Nro Pedido",
                "OBS",
                "OC",
                "CodClte",
                "Origen",
                "Prioridad",
                "Org.ID/CustomerID",
                "Secondary/SiteUseID1",
                "Cuenta/SiteUseID2",
                "DeliveryLocation/OrderTypeID",
                "ItemID",
                "UomCode",
                "Ct.Tarea",
                "PriceList",
                "Oracle",
                "PrecioOracle",
                "LPN",
                "Genero",
                "Fecha Final",
                "Marca",
                "Clase"
            ]
        },
        "stock": {
            "container": "#grillastock",
            "headers": [
                "C/Modelo",
                "C/Color",
                "Nº",
                "SKU",
                "Stock"
            ]
        },
        "otr": {
            "container": "#grillaotr",
            "headers": [
                "IDTienda",
                "Marca",
                "Clase",
                "Otr",
                "Digitado",
                "Carga",
                "Autorizado",
                "Excedente",
                "Archivo"
            ]
        }
    }
}